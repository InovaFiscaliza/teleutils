{
  "name": "teleutils",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "devuser",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.ssh",
      "target": "/home/devuser/.ssh"
    }
  ],
  "runArgs": [
    "--volume=/dados:/assets/data:z",
    "--volume=/data:/assets/monitoring:z",
    "--volume=/mnt/data:/assets/shared:z",
    "--group-add=1008"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "mutantdino.resourcemonitor"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },
  "containerEnv": {
    "PYSPARK_PYTHON": "${containerWorkspaceFolder}/.venv/bin/python",
    "PYSPARK_DRIVER_PYTHON": "${containerWorkspaceFolder}/.venv/bin/python"
  },
  "postCreateCommand": "uv sync --group dev && uv run pre-commit install",
  "postStartCommand": "uv sync --group dev"
}
